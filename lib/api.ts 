// ============ Logging ============
const log = (level: "info" | "warn" | "error", message: string, data?: any) => {
  if (!enableLogging) return;
  const prefix = `[API Client] ${level.toUpperCase()}:`;
  if (data) {
    console[level](prefix, message, data);
  } else {
    console[level](prefix, message);
  }
};

// ============ Configuration ============
export const setApiAuthToken = (token: string) => {
  authToken = token;
  log("info", "Auth token set");
};

export const removeApiAuthToken = () => {
  authToken = null;
  log("info", "Auth token removed");
};

export const setBaseURL = (url: string) => {
  baseURL = url;
  log("info", `Base URL set to: ${url}`);
};

export const setGlobalTimeout = (ms: number) => {
  timeout = ms;
  log("info", `Timeout set to: ${ms}ms`);
};

export const setApiLanguage = (lang: string) => {
  if (errorMessages[lang as keyof typeof errorMessages]) {
    currentLang = lang;
    log("info", `Language set to: ${lang}`);
  }
};

export const setEnableCache = (enabled: boolean) => {
  enableCache = enabled;
  if (!enabled) requestCache.clear();
  log("info", `Cache ${enabled ? "enabled" : "disabled"}`);
};

export const setCacheTTL = (ttl: number) => {
  cacheTTL = ttl;
  log("info", `Cache TTL set to: ${ttl}ms`);
};

export const setEnableOfflineQueue = (enabled: boolean) => {
  enableOfflineQueue = enabled;
  log("info", `Offline queue ${enabled ? "enabled" : "disabled"}`);
};

export const setMaxRetries = (retries: number) => {
  maxRetries = retries;
  log("info", `Max retries set to: ${retries}`);
};

export const setEnableLogging = (enabled: boolean) => {
  enableLogging = enabled;
  log("info", `Logging ${enabled ? "enabled" : "disabled"}`);
};

export const setRateLimit = (enabled: boolean, requestsPerMinute: number = 60) => {
  rateLimitEnabled = enabled;
  rateLimitRequestsPerMinute = requestsPerMinute;
  log("info", `Rate limit ${enabled ? "enabled" : "disabled"} (${requestsPerMinute}/min)`);
};

// ============ Intercepteurs ============
export const addRequestInterceptor = (interceptor: RequestInterceptor) => {
  requestInterceptors.push(interceptor);
  log("info", "Request interceptor added");
  return () => {
    requestInterceptors = requestInterceptors.filter(i => i !== interceptor);
    log("info", "Request interceptor removed");
  };
};

export const addResponseInterceptor = (interceptor: ResponseInterceptor) => {
  responseInterceptors.push(interceptor);
  log("info", "Response interceptor added");
  return () => {
    responseInterceptors = responseInterceptors.filter(i => i !== interceptor);
    log("info", "Response interceptor removed");
  };
};

// ============ Utilitaires ============
const getErrorMessage = (status: number, type: string): string => {
  const messages = errorMessages[currentLang as keyof typeof errorMessages] || errorMessages.fr;
  
  const errorMap: Record<number, string> = {
    0: messages.network,
    400: messages.badRequest,
    401: messages.unauthorized,
    403: messages.forbidden,
    404: messages.notFound,
    408: messages.timeout,
    429: messages.rateLimit,
    500: messages.server,
    502: messages.server,
    503: messages.server,
  };
  
  return errorMap[status] || messages[type as keyof typeof messages] || messages.unknown;
};

const buildUrl = (url: string): string => {
  if (url.startsWith("http")) return url;
  return baseURL ? `${baseURL}${url}` : url;
};

const getCacheKey = (method: string, url: string, body?: any): string => {
  return `${method}:${url}:${body ? JSON.stringify(body) : ""}`;
};

const checkRateLimit = (): boolean => {
  if (!rateLimitEnabled) return true;
  
  const now = Date.now();
  if (now - lastRequestReset >= 60000) {
    requestCount = 0;
    lastRequestReset = now;
  }
  
  if (requestCount >= rateLimitRequestsPerMinute) {
    return false;
  }
  
  requestCount++;
  return true;
};

// Traitement de la file d'attente offline
const processOfflineQueue = () => {
  if (offlineQueue.length === 0) return;
  
  log("info", `Processing offline queue (${offlineQueue.length} requests)`);
  const queue = [...offlineQueue];
  offlineQueue = [];
  
  queue.forEach(req => {
    request(req.url, { method: req.method, body: req.body, headers: req.headers })
      .then(req.resolve)
      .catch(req.reject);
  });
};

// Écouter le retour en ligne
if (typeof window !== "undefined") {
  window.addEventListener("online", () => {
    log("info", "Online - processing offline queue");
    processOfflineQueue();
  });
}

// ============ Exécution des intercepteurs ============
const applyRequestInterceptors = async (config: RequestInit): Promise<RequestInit> => {
  let result = config;
  for (const interceptor of requestInterceptors) {
    if (interceptor.onFulfilled) {
      result = await interceptor.onFulfilled(result);
    }
  }
  return result;
};

const applyResponseInterceptors = async <T>(response: FetchResponse<T>): Promise<FetchResponse<T>> => {
  let result = response;
  for (const interceptor of responseInterceptors) {
    if (interceptor.onFulfilled) {
      result = await interceptor.onFulfilled(result);
    }
  }
  return result;
};

const applyErrorInterceptors = async (error: any): Promise<any> => {
  let result = error;
  for (const interceptor of responseInterceptors) {
    if (interceptor.onRejected) {
      result = await interceptor.onRejected(result);
    }
  }
  return result;
};

// ============ Requête principale ============
async function request<T = any>(
  url: string,
  options: RequestInit & { skipCache?: boolean; retryCount?: number; skipOfflineQueue?: boolean } = {}
): Promise<FetchResponse<T>> {
  const method = options.method || "GET";
  const fullUrl = buildUrl(url);
  const isReadOnly = method === "GET";
  const cacheKey = getCacheKey(method, url, options.body);
  
  // Vérifier le rate limiting
  if (!checkRateLimit()) {
    const error = new Error(getErrorMessage(429, "rateLimit")) as ApiError<T>;
    error.status = 429;
    throw error;
  }
  
  // Vérifier le cache pour GET
  if (isReadOnly && enableCache && !options.skipCache) {
    const cached = requestCache.get(cacheKey);
    if (cached && Date.now() - cached.timestamp < cached.ttl) {
      log("info", `Cache hit for: ${url}`);
      return {
        data: cached.data as T,
        status: 200,
        statusText: "OK (cached)",
        headers: new Headers(),
        fromCache: true,
      };
    }
  }
  
  // Mode hors ligne : mettre en queue pour les requêtes non-GET
  if (typeof navigator !== "undefined" && !navigator.onLine && enableOfflineQueue && !isReadOnly && !options.skipOfflineQueue) {
    log("warn", `Offline - queuing request: ${method} ${url}`);
    
    return new Promise((resolve, reject) => {
      offlineQueue.push({
        id: `${Date.now()}-${Math.random()}`,
        url,
        method,
        body: options.body,
        headers: options.headers as Record<string, string>,
        resolve,
        reject,
        retryCount: 0,
        timestamp: Date.now(),
      });
      
      const error = new Error(getErrorMessage(0, "offline")) as ApiError<T>;
      error.status = 0;
      error.isOffline = true;
      reject(error);
    });
  }
  
  // Construction des headers
  const headers: Record<string, string> = {
    "Content-Type": "application/json",
    "Accept": "application/json",
    ...(options.headers as Record<string, string> || {}),
  };
  
  if (authToken) {
    headers["Authorization"] = `Bearer ${authToken}`;
  }
  
  // Construction de la configuration
  let config: RequestInit = {
    ...options,
    method,
    headers,
  };
  
  // Appliquer les intercepteurs de requête
  config = await applyRequestInterceptors(config);
  
  // Timeout et AbortController
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), timeout);
  config.signal = controller.signal;
  
  // Gestion des retries
  const maxAttempts = options.retryCount ?? (isReadOnly ? maxRetries : 1);
  let lastError: any;
  
  log("info", `Request: ${method} ${fullUrl}`);
  
  for (let attempt = 0; attempt <= maxAttempts; attempt++) {
    try {
      // Délai exponentiel entre les tentatives
      if (attempt > 0) {
        const delay = 1000 * Math.pow(2, attempt - 1);
        log("info", `Retry attempt ${attempt} for ${url} after ${delay}ms`);
        await new Promise(r => setTimeout(r, delay));
      }
      
      const response = await fetch(fullUrl, config);
      
      clearTimeout(timeoutId);
      
      // Traitement de la réponse
      const contentType = response.headers.get("content-type") || "";
      const isJson = contentType.includes("application/json");
      let data: any;
      
      if (response.status === 204) {
        data = null;
      } else if (isJson) {
        data = await response.json();
      } else {
        data = await response.text();
      }
      
      if (!response.ok) {
        const error = new Error(data?.message || response.statusText) as ApiError<T>;
        error.status = response.status;
        error.data = data;
        throw error;
      }
      
      const result: FetchResponse<T> = {
        data: data as T,
        status: response.status,
        statusText: response.statusText,
        headers: response.headers,
      };
      
      // Mettre en cache pour GET
      if (isReadOnly && enableCache) {
        requestCache.set(cacheKey, {
          data,
          timestamp: Date.now(),
          ttl: cacheTTL,
        });
        log("info", `Cached response for: ${url}`);
      }
      
      // Appliquer les intercepteurs de réponse
      return await applyResponseInterceptors(result);
      
    } catch (error: any) {
      lastError = error;
      
      // Ne pas réessayer pour certaines erreurs
      if (error.status === 401 || error.status === 403 || error.status === 404 || error.status === 400) {
        log("warn", `Request failed (no retry): ${method} ${url} - ${error.status}`);
        break;
      }
      
      // Erreur d'abort (timeout)
      if (error.name === "AbortError") {
        const timeoutError = new Error(getErrorMessage(408, "timeout")) as ApiError<T>;
        timeoutError.status = 408;
        timeoutError.isTimeout = true;
        lastError = timeoutError;
        log("error", `Request timeout: ${method} ${url}`);
        break;
      }
      
      log("error", `Request attempt ${attempt + 1} failed: ${error.message}`);
    }
  }
  
  clearTimeout(timeoutId);
  
  // Formater l'erreur réseau
  if (!lastError.status) {
    const networkError = new Error(getErrorMessage(0, "network")) as ApiError<T>;
    networkError.status = 0;
    networkError.isNetworkError = true;
    lastError = networkError;
  }
  
  // Appliquer les intercepteurs d'erreur
  return await applyErrorInterceptors(lastError);
}

// ============ API Export ============
export const api = {
  get: <T = any>(url: string, options?: Omit<RequestInit, "method" | "body">) =>
    request<T>(url, { ...options, method: "GET" }),
    
  post: <T = any>(url: string, body?: any, options?: Omit<RequestInit, "method">) =>
    request<T>(url, { ...options, method: "POST", body: body ? JSON.stringify(body) : undefined }),
    
  put: <T = any>(url: string, body?: any, options?: Omit<RequestInit, "method">) =>
    request<T>(url, { ...options, method: "PUT", body: body ? JSON.stringify(body) : undefined }),
    
  patch: <T = any>(url: string, body?: any, options?: Omit<RequestInit, "method">) =>
    request<T>(url, { ...options, method: "PATCH", body: body ? JSON.stringify(body) : undefined }),
    
  delete: <T = any>(url: string, options?: Omit<RequestInit, "method" | "body">) =>
    request<T>(url, { ...options, method: "DELETE" }),
};

