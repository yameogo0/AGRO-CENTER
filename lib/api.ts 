/**
 * API Client - Version complète et optimisée
 * 
 * Fonctionnalités :
 * - Gestion d'authentification (token)
 * - Timeout configurable
 * - Retry automatique (optionnel)
 * - Cache pour les requêtes GET
 * - File d'attente offline
 * - Messages d'erreur multilingues
 * - Intercepteurs de requêtes/réponses
 * - Rate limiting
 * - Compression
 * - Logging
 */

type FetchResponse<T> = {
  data: T;
  status: number;
  statusText: string;
  headers: Headers;
  fromCache?: boolean;
};

export interface ApiError<T = unknown> extends Error {
  status: number;
  data: T;
  isNetworkError?: boolean;
  isTimeout?: boolean;
  isOffline?: boolean;
}

interface RequestInterceptor {
  onFulfilled?: (config: RequestInit) => RequestInit | Promise<RequestInit>;
  onRejected?: (error: any) => any;
}

interface ResponseInterceptor {
  onFulfilled?: <T>(response: FetchResponse<T>) => FetchResponse<T> | Promise<FetchResponse<T>>;
  onRejected?: (error: any) => any;
}

interface QueuedRequest {
  id: string;
  url: string;
  method: string;
  body?: any;
  headers?: Record<string, string>;
  resolve: (value: any) => void;
  reject: (reason: any) => void;
  retryCount: number;
  timestamp: number;
}

// Configuration globale
let authToken: string | null = null;
let baseURL: string = "";
let timeout: number = 30000;
let maxRetries: number = 2;
let enableCache: boolean = true;
let enableOfflineQueue: boolean = true;
let enableLogging: boolean = process.env.NODE_ENV === "development";
let currentLang: string = "fr";
let cacheTTL: number = 60000; // 1 minute par défaut
let rateLimitEnabled: boolean = false;
let rateLimitRequestsPerMinute: number = 60;
let requestCount: number = 0;
let lastRequestReset: number = Date.now();

// Intercepteurs
let requestInterceptors: RequestInterceptor[] = [];
let responseInterceptors: ResponseInterceptor[] = [];

// Cache des requêtes GET
const requestCache = new Map<string, { data: any; timestamp: number; ttl: number }>();

// File d'attente offline
let offlineQueue: QueuedRequest[] = [];

